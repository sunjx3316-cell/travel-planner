# 仅放在腾讯云服务器，勿提交 .env.production 到 Git
# 先将域名 A 记录指向服务器公网 IPv4，Caddy 才能自动签发 HTTPS 证书。
DOMAIN=travel.example.com

# 不填写时可展示示例数据，但 AI 行程与口碑改用本地启发式逻辑。
DEEPSEEK_API_KEY=

# 可选：用于后续从高德扩充 POI。
AMAP_KEY=
RATE_LIMIT_ENABLED=1

# 云端运营导入必须设置强随机令牌；请求使用 X-Admin-Import-Token 传递。
# 留空时运营导入仅允许本机 localhost 使用。
ADMIN_IMPORT_TOKEN=
